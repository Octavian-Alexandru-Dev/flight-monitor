# Copy to .env and fill in what you need. Everything is optional.
FM_DATABASE_URL=sqlite://data/flight-monitor.db
FM_BIND=127.0.0.1:8080
FM_PUBLIC_URL=http://127.0.0.1:8080
# Chrome/Chromium for searches Google has not cached. Unset: installed Chrome,
# otherwise Chromium is downloaded into data/chromium (on a Raspberry Pi: apt install chromium).
# FM_CHROME=/usr/bin/chromium

# Telegram alerts: create a bot with @BotFather, then send it a message and
# read your chat id from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Travelpayouts Data API token (free): enables the cheap scan phase.
TRAVELPAYOUTS_TOKEN=

FM_DEFAULT_BUDGET=40
FM_DEFAULT_POLL_HOURS=6
FM_CACHE_TTL_MINUTES=60
FM_VERIFY_TOP_N=8
FM_GOOGLE_MIN_INTERVAL_SECS=20
FM_DAILY_SUMMARY_HOUR=8

# Optional local LLM (OpenAI-compatible, e.g. Ollama) for natural-language searches.
FM_LLM_URL=http://localhost:11434/v1/chat/completions
FM_LLM_MODEL=llama3.1
